{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a-share-ai-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 0 * * 1-5"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a-share-ai-tracker-db",
      "database_id": "907b4cde-4d1f-4710-a4b0-73b7daeeb769"
    }
  ]
}